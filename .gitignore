# ==========================================
# AEGIS-SOC // Git Ignore Configuration
# ==========================================

# 1. Environment Secrets & API Keys
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# 3. Virtual Environments
venv/
.venv/
env/
ENV/

# 4. Large Datasets & Log Files (Prevents GitHub 100MB File Limits)
*.csv
my_dataset.csv/
rba-dataset.csv
enterprise_auth_logs.csv
*.log
*.sqlite
*.db

# 5. ChromaDB Vector Store Persistence
chroma_db/
.chroma/

# 6. IDE, OS & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 7. Antigravity System Generated Artifacts
.system_generated/
scratch/

# 8. Project Thesis Reports, Visuals & Doc Converters (Kept Locally Only)
*.docx
*.pdf
AEGIS_SOC_8_STAGE_FRAMEWORK.md
METHODOLOGY_DATA_FLOW.md
METHODOLOGY_PRESENTATION_GUIDE.md
PROJECT_ARCHITECTURE_AND_DATAFLOW.md
PROJECT_TECHNICAL_INVENTORY.md
RUNNING_COMMANDS.md
UNIVERSITY_PANEL_PRESENTATION_SCRIPT.md
report_screenshots/
docs/
tools/convert_md_to_docx.py
tools/generate_*.py
