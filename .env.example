# AEGIS-SOC Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Google Gemini API Key (Get key at https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# REAL SMTP SECURITY WARNING EMAIL DISPATCH CONFIGURATION (Optional)
# To receive real warning emails on your inbox/phone:
# 1. Set your Gmail address in SMTP_USERNAME and ALERT_RECIPIENT_EMAIL
# 2. Generate a Gmail App Password (https://myaccount.google.com/apppasswords) and set it in SMTP_PASSWORD
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_RECIPIENT_EMAIL=recipient_email@gmail.com
